# Touchedbyfaithdee Studio. Copy this file to `.env.local` and fill in the values.
# Never commit your real .env / .env.local. The npm scripts (seed,
# reset-password, sync-indexes) read .env.local first, then .env.

# App — public base URL of the site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Salon timezone (IANA name). Used to resolve "today" for the dashboard so the
# count stays correct on UTC servers. Defaults to Africa/Johannesburg (SAST).
SALON_TIMEZONE=Africa/Johannesburg

# MongoDB — Atlas connection string (Database > Connect > Drivers).
# Use the dedicated Touchedbyfaithdee database. The database name MUST contain
# "touchedbyfaithdee" or the scripts refuse to run (scripts/db-env.ts).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/touchedbyfaithdee

# Auth.js — session secret + canonical URL
# Generate a strong secret with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Cloudinary — image uploads (Dashboard > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — transactional email (https://resend.com/api-keys)
# Keep onboarding@resend.dev for local testing (it only delivers to the Resend
# account's own address). In production use an address on a domain verified in
# Resend — a Gmail address cannot be a sender. Emails show as
# "Touchedbyfaithdee Studio <address>" and replies go to the salon's Gmail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# The owner: dashboard sign-in address (emailed code) AND where
# new-booking / contact-form notifications go. OWNER_NAME is optional.
OWNER_EMAIL=owner@example.com
OWNER_NAME=

# Optional: the developer's dashboard sign-in address, for testing. Can use
# the dashboard but not the owner-only settings. Leave blank in production
# once handed over.
DEVELOPER_EMAIL=

# Paystack — online booking payments. CURRENTLY OFF
# (ONLINE_PAYMENTS_ENABLED in features/bookings/schema.ts); leave blank. (https://dashboard.paystack.com/#/settings/developers)
#
# Test mode keys start sk_test_ / pk_test_; live keys start sk_live_ / pk_live_.
# The SECRET key must never reach the browser — it can charge cards and issue
# refunds. It is read only in lib/paystack.ts, which is server-only, and it has
# no NEXT_PUBLIC_ prefix precisely so Next cannot bundle it into client code.
PAYSTACK_SECRET_KEY=
# Public key. Not used by the current redirect flow (the browser never talks to
# Paystack directly), but safe to expose and needed if you ever switch to the
# inline popup checkout.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
#
# Webhook: set this in the Paystack dashboard, not here —
#   https://<your-domain>/api/payments/webhook
# It is the reliable half of the flow: the browser callback only fires if the
# customer returns to the tab, and many close it as soon as their bank app
# confirms. Paystack cannot reach localhost, so use a tunnel (ngrok, cloudflared)
# when testing webhooks locally. Signatures are verified against
# PAYSTACK_SECRET_KEY, so no separate webhook secret is needed.
#
# NEXT_PUBLIC_APP_URL above builds the return URL Paystack redirects to. If it
# is wrong, paying customers land on the wrong host after checkout.



# Scheduled emails (reminders + follow-ups): call GET /api/cron/emails every 15 minutes
# with header "Authorization: Bearer <CRON_SECRET>". Any long random string.
CRON_SECRET=
